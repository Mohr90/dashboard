# ---------------------------------------------------------------------------
# open-router-stats – Konfiguration
# Kopiere diese Datei nach ".env" und trage deinen Key ein.
# ---------------------------------------------------------------------------

# Pflicht: OpenRouter API Key.
# Ein normaler Inferenz-Key reicht für /credits und /key (Guthaben + Verbrauch).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Management-Key (https://openrouter.ai/settings/management-keys).
# Schaltet die Analytics-API frei (Verbrauch pro Modell / pro Tag direkt von
# OpenRouter). Ohne ihn nutzt das Dashboard die lokal mitgeschriebene Historie.
OPENROUTER_MANAGEMENT_KEY=

# --- Server ---
HOST=127.0.0.1
PORT=8787

# Abfrage-Intervall der OpenRouter-API in Sekunden (Minimum 15).
POLL_SECONDS=60

# Wie viele Tage Verlauf im Dashboard angezeigt werden.
HISTORY_DAYS=90

# --- Sonstiges ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Wechselkurs-Quelle (ECB via Frankfurter, kein API-Key nötig).
FX_URL=https://api.frankfurter.dev/v1/latest
# Fallback-Kurs USD -> EUR, falls die FX-API nicht erreichbar ist.
EUR_PER_USD_FALLBACK=0.89
FX_REFRESH_HOURS=12
DB_PATH=data/stats.db
