{
  "name": "open-router-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live-Dashboard und MCP-Server für OpenRouter-Guthaben, Verbrauch, Burn-Rate und Modellpreis-Vergleich.",
  "keywords": ["openrouter", "dashboard", "credits", "mcp", "llm-costs"],
  "license": "MIT",
  "author": "Steffen Mohr (https://github.com/Mohr90)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mohr90/open-router-stats.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "tsx src/cli.ts serve",
    "dev": "tsx watch src/cli.ts serve",
    "snapshot": "tsx src/cli.ts snapshot",
    "summary": "tsx src/cli.ts summary",
    "models": "tsx src/cli.ts models",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/stats.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
